# ===== Bắt buộc =====
POSTGRES_PASSWORD=doi-mat-khau-db
DATABASE_URL=postgres://trian:doi-mat-khau-db@db:5432/trian
# Địa chỉ web mà sinh viên truy cập (dùng cho SSO callback)
NEXTAUTH_URL=http://localhost:3000
# Chuỗi ngẫu nhiên dài: openssl rand -base64 32
NEXTAUTH_SECRET=thay-bang-chuoi-ngau-nhien

# ===== Đăng nhập Outlook (Microsoft Entra ID) =====
# Redirect URI cần đăng ký: {NEXTAUTH_URL}/api/auth/callback/azure-ad
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=
# Chỉ cho email sinh viên (ngăn cách bằng dấu phẩy). Để trống = không giới hạn.
STUDENT_EMAIL_DOMAINS=st.example.edu.vn
# true = hiện ô "đăng nhập thử" bằng email bất kỳ (chỉ để test). PHẢI để false khi chạy thật.
AUTH_DEV_LOGIN=true

# ===== Kiểm duyệt AI (Google AI Studio) =====
# Nhiều key ngăn cách bằng dấu phẩy, hết quota sẽ tự chuyển key. Đổi key xong: docker compose up -d
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-2.5-flash

# ===== Thời gian mở cổng gửi (để trống = luôn mở) =====
OPEN_AT=2026-11-15T00:00:00+07:00
CLOSE_AT=2026-11-21T23:59:59+07:00

# ===== Quản trị =====
ADMIN_PASSWORD=doi-mat-khau-admin
# Token cho web quản trị chung gọi /api/admin/* (header Authorization: Bearer <token>)
ADMIN_API_TOKEN=
