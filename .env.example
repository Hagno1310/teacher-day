# Database
POSTGRES_PASSWORD=doi-mat-khau-db
DATABASE_URL=postgres://trian:doi-mat-khau-db@db:5432/trian

# Địa chỉ web sinh viên truy cập (SSO quay về {NEXTAUTH_URL}/api/auth/callback/ptit)
NEXTAUTH_URL=http://localhost:3000
# Chuỗi ngẫu nhiên dài: openssl rand -base64 32
NEXTAUTH_SECRET=thay-bang-chuoi-ngau-nhien

# Đăng nhập: SSO SLINK PTIT bật sẵn. AUTH_DEV_LOGIN=true chỉ để thử, đặt false khi chạy thật
STUDENT_EMAIL_DOMAINS=stu.ptit.edu.vn
AUTH_DEV_LOGIN=false

# Kiểm duyệt AI: nhiều key Gemini ngăn cách bằng dấu phẩy
GEMINI_API_KEYS=

# Sau thời điểm này chỉ còn xem, không gửi được nữa
CLOSE_AT=2026-11-17T00:00:00+07:00

# Quản trị
ADMIN_PASSWORD=doi-mat-khau-admin
# Token cho web quản trị chung gọi /api/admin/* (header Authorization: Bearer <token>)
ADMIN_API_TOKEN=thay-bang-chuoi-ngau-nhien

# Tùy chọn (đã có mặc định trong code): OPEN_AT, GEMINI_MODEL (mặc định gemini-3.5-flash-lite), PTIT_SSO=false, PTIT_SSO_ISSUER, PTIT_SSO_CLIENT_ID
