# Database
POSTGRES_PASSWORD=doi-mat-khau-db
DATABASE_URL=postgres://trian:doi-mat-khau-db@db:5432/trian

# Domain chạy thật, Caddy tự cấp HTTPS cho domain này
DOMAIN=teacherday.ript.vn

# Tự lấy domain/protocol từ request và proxy cho callback đăng nhập/đăng xuất.
AUTH_TRUST_HOST=true
# Tùy chọn cố định một domain khi deploy; không để NEXTAUTH_URL= rỗng.
NEXTAUTH_URL=https://teacherday.ript.vn
# Chuỗi ngẫu nhiên dài: openssl rand -base64 32
NEXTAUTH_SECRET=thay-bang-chuoi-ngau-nhien

# Đăng nhập: SSO SLINK PTIT bật sẵn. AUTH_DEV_LOGIN=true chỉ để thử, đặt false khi chạy thật
PTIT_SSO=true
PTIT_SSO_NAME=SLINK PTIT
PTIT_SSO_ISSUER=https://gwdu.ptit.edu.vn/sso/realms/ptit
PTIT_SSO_CLIENT_ID=ptit-ript-public
# Client công khai dùng PKCE, để trống secret; chỉ điền nếu được cấp client riêng có secret
PTIT_SSO_CLIENT_SECRET=
STUDENT_EMAIL_DOMAINS=stu.ptit.edu.vn
AUTH_DEV_LOGIN=false

# Dev RIPT: đổi issuer thành https://sso.ript.vn/realms/ript, client ID thành ript-connect
# và PTIT_SSO_NAME=RIPT SSO (dev). Xem README để cấu hình giới hạn email khi thử.

# Kiểm duyệt AI: nhiều key Gemini ngăn cách bằng dấu phẩy
GEMINI_API_KEYS=
# Ưu tiên từ trái sang phải; tự đổi model khi đạt giới hạn hoặc gặp lỗi
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.6-flash,gemini-3-flash-preview

# Sau thời điểm này chỉ còn xem, không gửi được nữa
CLOSE_AT=2026-11-17T00:00:00+07:00

# Quản trị
ADMIN_PASSWORD=doi-mat-khau-admin
# Token cho web quản trị chung gọi /api/admin/* (header Authorization: Bearer <token>)
ADMIN_API_TOKEN=thay-bang-chuoi-ngau-nhien

# Tùy chọn: OPEN_AT. GEMINI_MODEL cũ vẫn được ưu tiên nếu chưa đặt GEMINI_MODELS.
